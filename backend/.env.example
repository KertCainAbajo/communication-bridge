APP_NAME="Communication Bridge"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local development can use SQLite. Set DB_CONNECTION=pgsql for Supabase.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# Supabase PostgreSQL settings (use the Session Pooler for IPv4-only hosts).
# DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Comma-separated allowed origins, or * for a public read-only API.
CORS_ALLOWED_ORIGINS=*
COMMUNICATION_DEFAULT_LANGUAGE=en
COMMUNICATION_API_RATE_LIMIT=600
